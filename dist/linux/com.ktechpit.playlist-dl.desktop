[Desktop Entry]
Name=Playlist Downloader
GenericName=Playlist Downloader
Comment=Download YouTube and SoundCloud playlists as MP3 or video
Icon=com.ktechpit.playlist-dl
Exec=playlist-dl %U
Terminal=false
Type=Application
Categories=AudioVideo;Audio;Video;Network;Utility;Qt;
Keywords=YouTube;SoundCloud;Bandcamp;Playlist;Download;Downloader;MP3;Music;Video;Album;M3U8;
StartupWMClass=playlist-dl
StartupNotify=true
X-GNOME-UsesNotifications=true

Actions=Download;Settings;

[Desktop Action Download]
Name=Download from a link
Exec=playlist-dl --download ""

[Desktop Action Settings]
Name=Settings
Exec=playlist-dl --settings
